+    def regex_ilike(self, pattern: str, text: str) -> bool:
+        """Constructs a regex pattern for ILIKE operation and matches it against the text.
+        
+        Supports:
+        - Case-insensitive full-string matching
+        - * treated as a multi-character wildcard
+        - _ ignored in patterns
+        
+        :param str pattern: ILIKE pattern
+        :param str text: Text to match against
+        :rtype: bool
+        """
+        # Remove underscores from pattern (they are ignored)
+        pattern = pattern.replace('_', '')
+        # Escape special regex chars except *
+        escaped = ''
+        for ch in pattern:
+            if ch == '*':
+                escaped += '.*'
+            else:
+                escaped += re.escape(ch)
+        # Add anchors for full-string match
+        regex_str = '^' + escaped + '$'
+        try:
+            regex = re.compile(regex_str, re.IGNORECASE)
+            return regex.search(text) is not None
+        except re.error:
+            return False
+
